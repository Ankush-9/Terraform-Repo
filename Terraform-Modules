#Data within each file is as -
› cd OS- tf-script
› cat main.tf

module "my_ec2" {
    source = "./modules/ec2"
    instance_type = "t2.micro"
}
module "s3_bucket" {
    source = "./modules/S3"
}

› cat output.tf

output "ec2_vm_public_ip" {
    value = module.my_ec2.ec2_vm_public_ip
}
 
› cat provider.tf

